rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A user reads and writes only their own profile and addresses.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /addresses/{addressId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Catalog: read-only for everyone (written by the seed script / console).
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if false;

      match /menu/{itemId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders: the client creates and reads only its own orders.
    // `status`, `courier` and prices are changed only by Cloud Functions
    // (Admin SDK bypasses these rules). The app creates orders through the
    // `api/createOrder` function; a direct create is allowed only in the
    // initial state and is re-priced on the server by `simulateCourier`.
    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'created'
        && !('courier' in request.resource.data)
        && !('pricedByServer' in request.resource.data);

      allow update, delete: if false;
    }
  }
}
