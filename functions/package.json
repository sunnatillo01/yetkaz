{
  "name": "yetkaz-functions",
  "private": true,
  "description": "Cloud Functions for Yetkaz: order API, courier simulator, push notifications",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"lib/**/*.test.js\"",
    "seed": "npm run build && node lib/scripts/seed.js",
    "serve": "npm run build && firebase emulators:start",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
